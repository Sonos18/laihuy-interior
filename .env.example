# Supabase project URL (public — safe to expose to the browser)
NUXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Feature flag: true = serve images from Supabase Storage, false = fall back to /public
NUXT_PUBLIC_USE_SUPABASE_MEDIA=false

# Service-role key — LOCAL MIGRATION/UPLOAD SCRIPTS ONLY.
# Never commit a real value, never add it to Vercel/CI env, never prefix with NUXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=
